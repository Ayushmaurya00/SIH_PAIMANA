# PAIMANA AI Production Example Configuration (.env.example)
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,https://paimana.mospi.gov.in
DATABASE_PATH=paimana.db
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY_SEC=0.2
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.6-flash
API_KEY=your_secure_api_key_here
RATE_LIMIT_PER_MINUTE=30
TESTSPRITE_API_KEY=
JWT_SECRET=generate-with-openssl-rand-hex-32-min-32-chars
JWT_EXPIRY_MINUTES=120
